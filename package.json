{
  "name": "kade",
  "version": "1.4.0",
  "description": "An Electron application with React",
  "main": "./out/main/index.js",
  "homepage": "https://electron-vite.org",
  "license": "LGPL-3.0",
  "author": {
    "name": "Shawn Banasick",
    "email": "ken.q.tools@gmail.com",
    "url": "https://github.com/shawnbanasick/kade"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --inspect --sourcemap ",
    "build:css": "npx @tailwindcss/cli -i src/input.css -o public/output.css --watch",
    "pack": "electron-builder --dir",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "knip": "knip"
  },
  "build": {
    "extraFiles": [
      "app/localization/locales/**/*"
    ],
    "win": {
      "icon": "build/icons/win/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    }
  },
  "dependencies": {
    "@ag-grid-community/all-modules": "^27.3.0",
    "@ag-grid-community/react": "^32.3.9",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^3.0.0",
    "@tailwindcss/postcss": "^4.3.5",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.2",
    "d3-svg-to-png": "^0.3.2",
    "docx": "^8.5.0",
    "dotenv": "^16.4.5",
    "electron-fetch": "^1.9.1",
    "electron-settings": "^4.0.4",
    "es-toolkit": "^1.53.2",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^7.2.1",
    "i18next-electron-fs-backend": "^3.0.2",
    "i18next-fs-backend": "^2.7.0",
    "i18next-resources-to-backend": "^1.3.0",
    "immer": "^10.1.1",
    "jszip": "^3.10.2",
    "lodash": "^4.18.1",
    "papaparse": "^5.7.1",
    "promise-worker": "^2.0.1",
    "react-color": "^2.19.3",
    "react-dropzone": "^14.2.3",
    "react-i18next": "^14.1.0",
    "react-icons": "^5.7.0",
    "react-papaparse": "^4.4.0",
    "react-tabs": "^6.1.1",
    "react-toastify": "^11.2.0",
    "react-toggle": "^4.1.3",
    "reactflow": "^11.11.4",
    "rfdc": "^1.4.1",
    "save-svg-as-png": "^1.4.17",
    "semver": "^7.8.6",
    "tailwind-merge": "^3.7.0",
    "uuid": "^9.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^3.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "code-inspector-plugin": "^2.0.9",
    "daisyui": "^5.8.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "knip": "^6.46.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.2": true,
    "electron@45.4.1": true
  }
}
